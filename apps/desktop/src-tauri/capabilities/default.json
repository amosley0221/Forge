{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions the Forge window needs, plus the provider hosts it may call.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.meshy.ai/*"
        },
        {
          "url": "https://*.meshy.ai/*"
        },
        {
          "url": "https://api.tripo3d.ai/*"
        },
        {
          "url": "https://*.tripo3d.ai/*"
        },
        {
          "url": "https://*.amazonaws.com/*"
        },
        {
          "url": "https://*.cloudfront.net/*"
        },
        {
          "url": "https://*.r2.cloudflarestorage.com/*"
        },
        {
          "url": "https://*.blob.core.windows.net/*"
        },
        {
          "url": "https://storage.googleapis.com/*"
        },
        {
          "url": "https://*.googleapis.com/*"
        },
        {
          "url": "https://*.githubusercontent.com/*"
        },
        {
          "url": "https://github.com/*"
        }
      ]
    }
  ]
}
